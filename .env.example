# Copy to .env (repo root) and fill in. .env is gitignored.

# Anthropic — required by all agents
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Jenkins sub-agent
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=

# Critical-events pipeline (pipeline/critical_events_pipeline.py)
# Comma-separated error codes to skip; empty value disables filtering.
IGNORED_CODES=
# Comma-separated OTA versions to poll, e.g. 6.15.rc.1
ALLOWED_OTA_VERSIONS=

# Data polling filters (pipeline/data_polling.py)
# Comma-separated product lines. Allowed values: krait,krait2,bagheera2,bagheera3,octo
# If empty, all product lines are considered.
PRODUCT_LINES=
# ALLOWED_OTA_VERSIONS above is also used by data polling.
# In data polling, exact OTA matching is applied after product-line selection.
OBS_OTA_VERSIONS= 
#OTA versions for Observation files
# Optional: path to a device-automation checkout, used only for the
# testcase-count stat in the Streamlit header.
# DEVICE_AUTOMATION_ROOT=~/Documents/device-automation

# Critical-bug report agent (atlas/critical_bug_report_agent.py)
AZURE_OAI=
OAI_ENDPOINT=
OAI_MODEL=
# Optional; code falls back to 2024-08-01-preview if unset.
OAI_API_VERSION=
