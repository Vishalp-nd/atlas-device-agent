# Copy to .env (repo root) and fill in. .env is gitignored.

# Anthropic — required by all agents
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Jenkins sub-agent
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=

# Critical-events pipeline (pipeline/critical_events_pipeline.py)
# Comma-separated error codes to skip; empty value disables filtering.
IGNORED_CODES=
# Comma-separated OTA versions to poll, e.g. 6.15.rc.1
ALLOWED_OTA_VERSIONS=

# Optional: path to a device-automation checkout, used only for the
# testcase-count stat in the Streamlit header.
# DEVICE_AUTOMATION_ROOT=~/Documents/device-automation
