# Copy to db_credentials.ini (repo root) and fill in. db_credentials.ini is
# gitignored — never commit real credentials.
#
# Sections used by Atlas:
#   IRAVATH_DB / POLL_USER_DB — local Postgres (atlas_db) holding critical events
#   CLICKHOUSE_DB            — local ClickHouse (atlas) holding classified critical events
#   SNOWFLAKE_STAG_DB         — Snowflake staging, read by the critical-events tool

[IRAVATH_DB]
database=atlas_db
host=host.docker.internal
user=
password=
port=5432

[POLL_USER_DB]
database=atlas_db
host=host.docker.internal
user=
password=
port=5432

[CLICKHOUSE_DB]
database=atlas
host=127.0.0.1
user=default
password=
port=9000

[SNOWFLAKE_STAG_DB]
user =
pk_ssm_parameter =
role =
warehouse =
database =
schema =
account =
